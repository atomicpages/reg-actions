{
  "name": "reg-actions",
  "version": "3.0.0",
  "private": true,
  "description": "github actions for reg",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomicpages/reg-actions.git"
  },
  "license": "MIT",
  "author": "GitHub",
  "type": "module",
  "main": "dist/lib/index.cjs",
  "scripts": {
    "build": "npm-run-all -p package:entry package:main package:worker -s package:wasm",
    "check:dist": "pnpm build && test -z \"$(git status --porcelain --untracked-files=all -- dist)\"",
    "typecheck": "tsc --noEmit",
    "package:entry": "esbuild node_modules/@bokuweb/reg-cli-wasm/dist/entry.cjs --bundle --platform=node --format=cjs --outfile=dist/lib/entry.cjs",
    "package:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/lib/index.cjs",
    "package:wasm": "cp node_modules/@bokuweb/reg-cli-wasm/dist/shared/reg.wasm dist/lib/reg.wasm",
    "package:worker": "esbuild node_modules/@bokuweb/reg-cli-wasm/dist/worker.cjs --bundle --platform=node --format=cjs --outfile=dist/lib/worker.cjs"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0",
    "@bokuweb/reg-cli-wasm": "0.0.0-experimental6",
    "adm-zip": "^0.6.0",
    "chalk": "^6.0.0",
    "cpy": "13.2.2",
    "exponential-backoff": "^3.1.3",
    "fast-glob": "^3.3.3",
    "glob": "13.0.6",
    "loglevel": "^1.9.2",
    "mkdirp": "3.0.1",
    "reg-cli": "0.19.0-rc0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@octokit/openapi-types": "^28.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
